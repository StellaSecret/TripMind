{
  "name": "tripmind-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npx --no playwright test",
    "test:offline": "npx --no playwright test --grep-invert \"@live\"",
    "test:live": "npx --no playwright test --grep \"@live\"",
    "test:headed": "npx --no playwright test --headed",
    "test:ui": "npx --no playwright test --ui",
    "test:report": "npx --no playwright show-report",
    "prepare": "cd .. && husky e2e/.husky",
    "test:new": "npx --no playwright test --grep-invert \"@live\" --project=chromium tests/09-time-picker.spec.ts tests/10-analysis-cache.spec.ts tests/11-lang-rerender.spec.ts tests/12-station-picker.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "husky": "^9.0.0"
  }
}
