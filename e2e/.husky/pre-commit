#!/usr/bin/env bash
# e2e/.husky/pre-commit
#
# Checks that run locally before every commit.
# Fast (<15s), no server needed, no browser.
# Heavy checks (Playwright, CodeQL, audit) stay in GitHub Actions.

set -e
ROOT="$(git rev-parse --show-toplevel)"
STAGED=$(git diff --cached --name-only)

# ─────────────────────────────────────────────────────────────
# 1. SECRET SCAN — block hardcoded tokens/keys before they land
#    in git history (TruffleHog in CI is already too late)
# ─────────────────────────────────────────────────────────────
echo "🔍 [1/4] Scanning for secrets in staged files…"

STAGED_SOURCE=$(echo "$STAGED" | grep -E '\.(js|ts|html|json|env)$' || true)

if [ -n "$STAGED_SOURCE" ]; then
  for file in $STAGED_SOURCE; do
    [ -f "$ROOT/$file" ] || continue
    # Hardcoded key=value assignments (apiKey = "abc123...")
    if grep -qiE "(apikey|api_key|token|secret|password|passwd|credential)[[:space:]]*[=:][[[:space:]]*['\"]([a-zA-Z0-9+/=_-]){16,}" "$ROOT/$file" 2>/dev/null; then
      echo ""
      echo "❌ BLOCKED: Potential secret found in $file"
      echo "   Use environment variables or GitHub Secrets instead."
      echo "   False positive? Use: git commit --no-verify"
      echo ""
      exit 1
    fi
    # Known token prefixes (AWS, OpenAI, GitHub PAT, Google)
    if grep -qE "(AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{32}|ghp_[a-zA-Z0-9]{36}|AIza[0-9A-Za-z_-]{35})" "$ROOT/$file" 2>/dev/null; then
      echo ""
      echo "❌ BLOCKED: Known secret pattern found in $file"
      echo "   False positive? Use: git commit --no-verify"
      echo ""
      exit 1
    fi
  done
fi
echo "   ✓ No secrets detected"

# ─────────────────────────────────────────────────────────────
# 2. JS SYNTAX CHECK — catch broken JS before a 3-min CI run
# ─────────────────────────────────────────────────────────────
echo "🔧 [2/4] Checking JS syntax…"

STAGED_JS=$(echo "$STAGED" | grep '^www/.*\.js$' || true)
HAS_ERROR=0

if [ -n "$STAGED_JS" ]; then
  for file in $STAGED_JS; do
    [ -f "$ROOT/$file" ] || continue
    if ! node --check "$ROOT/$file" 2>&1; then
      echo "❌ Syntax error in $file"
      HAS_ERROR=1
    fi
  done
fi

if [ "$HAS_ERROR" -eq 1 ]; then
  echo ""
  echo "❌ BLOCKED: Fix JS syntax errors before committing."
  exit 1
fi
echo "   ✓ JS syntax OK"

# ─────────────────────────────────────────────────────────────
# 3. UNIT TESTS — pure function tests, no browser, ~2s
#    Tests: calcScore, LRUCache, classifyError, MODE_COSTS
#    Skipped if unit/ deps not installed yet (first clone)
# ─────────────────────────────────────────────────────────────
echo "🧪 [3/4] Running unit tests…"

UNIT_DIR="$ROOT/unit"
STAGED_UNIT=$(echo "$STAGED" | grep -E '^(www/js/|unit/)' || true)

if [ -d "$UNIT_DIR/node_modules" ]; then
  # Always run unit tests if www/js/ or unit/ files changed
  # Run all tests even if unchanged — they're fast enough (<3s)
  if ! (cd "$UNIT_DIR" && npm test --silent 2>&1); then
    echo ""
    echo "❌ BLOCKED: Unit tests failed. Fix before committing."
    echo "   Run 'cd unit && npm test' to see details."
    echo ""
    exit 1
  fi
  echo "   ✓ Unit tests passed"
else
  echo "   ⚠️  unit/node_modules not found — skipping unit tests"
  echo "      Run 'cd unit && npm install' to enable them"
fi

# ─────────────────────────────────────────────────────────────
# 4. TEST COVERAGE REMINDER — warn if www/js/ changed but
#    neither e2e/tests/ nor unit/tests/ was staged
#    (warning only, does not block)
# ─────────────────────────────────────────────────────────────
echo "📋 [4/4] Checking test coverage…"

WWW_CHANGED=$(echo "$STAGED" | grep '^www/js/' || true)
E2E_CHANGED=$(echo "$STAGED" | grep '^e2e/tests/' || true)
UNIT_CHANGED=$(echo "$STAGED" | grep '^unit/tests/' || true)

if [ -n "$WWW_CHANGED" ] && [ -z "$E2E_CHANGED" ] && [ -z "$UNIT_CHANGED" ]; then
  echo ""
  echo "⚠️  WARNING: www/js/ modified but no test files staged."
  echo "   Changed: $(echo "$WWW_CHANGED" | tr '\n' ' ')"
  echo "   Consider updating e2e/tests/ or unit/tests/ before pushing."
  echo "   (Warning only — commit proceeds)"
  echo ""
else
  echo "   ✓ Test files look up to date"
fi

echo ""
echo "✅ Pre-commit checks passed."
